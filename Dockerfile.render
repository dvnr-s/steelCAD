# SteelCAD — single-container image for Render (see render.yaml).
#
# Render runs one container per web service and its free tier cannot receive
# private-network traffic, so the compose layout (separate nginx + backend
# containers) does not map onto it. This image bundles both: nginx serves the
# SPA and proxies API routes to uvicorn on loopback, exactly as in
# docker-compose.prod.yml but within one container. Build context: repo root.

# ─── Frontend build ──────────────────────────────────────
FROM node:20-alpine AS frontend
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

# ─── Runtime: Python API + nginx ─────────────────────────
FROM python:3.12-slim

# WeasyPrint system libraries — keep in sync with backend/Dockerfile.
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libcairo2 \
    shared-mime-info \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default \
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log

WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ .
RUN rm -rf venv .venv

# Same nginx config as the compose deploy; only the upstream changes from the
# compose service name to loopback. The grep fails the build if the sed misses.
COPY --from=frontend /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
RUN sed -i 's#http://backend:8000#http://127.0.0.1:8000#' /etc/nginx/conf.d/default.conf \
    && grep -q 'proxy_pass         http://127.0.0.1:8000;' /etc/nginx/conf.d/default.conf

COPY deploy/render/ /opt/steelcad/
RUN sed -i 's/\r$//' /opt/steelcad/start.sh \
    && cp /opt/steelcad/cloudflare-realip.conf /etc/nginx/conf.d/ \
    && nginx -t

ENV APP_ENV=production
CMD ["bash", "/opt/steelcad/start.sh"]
