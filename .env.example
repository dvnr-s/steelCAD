# SteelCAD — Environment Configuration Template
# Copy this file to .env and fill in real values before running.
#
# Generate a secure JWT secret:  openssl rand -hex 32
# Never commit .env — it is gitignored.

# ── App ─────────────────────────────────────────────────────────────
# "development" or "production"
# In production mode the app refuses to start with the default JWT secret.
APP_ENV=development

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://steelcad:CHANGE_ME@localhost:5432/steelcad
POSTGRES_USER=steelcad
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=steelcad

# ── JWT ──────────────────────────────────────────────────────────────
# REQUIRED in production: run `openssl rand -hex 32` and paste the output here.
JWT_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. In production set your real domain.
# Example: CORS_ORIGINS=https://steelcad.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
