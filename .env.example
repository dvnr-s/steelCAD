# SteelCAD — Environment Configuration Template
# Copy this file to .env and fill in real values before running.
#
# Generate a secure JWT secret:  openssl rand -hex 32
# Never commit .env — it is gitignored.

# ── App ─────────────────────────────────────────────────────────────
# "development" or "production"
# In production mode the app refuses to start if the JWT secret is the dev
# default or too short, if the database uses default/localhost credentials,
# or if CORS_ORIGINS contains a wildcard.
APP_ENV=development

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://steelcad:CHANGE_ME@localhost:5432/steelcad
POSTGRES_USER=steelcad
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=steelcad
# Require TLS on the DB connection. Keep false for the internal compose
# network; set true when DATABASE_URL points at an external/managed Postgres.
DATABASE_SSL=false

# ── JWT ──────────────────────────────────────────────────────────────
# REQUIRED in production: run `openssl rand -hex 32` and paste the output here.
JWT_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Never use "*".
# In production behind nginx the SPA is same-origin — leave this empty there,
# or set your real domain if the frontend is hosted separately.
# Example: CORS_ORIGINS=https://steelcad.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
